# Pulse AI Discovery Engine — Environment Configuration Template
# Copy this file to .env before starting the application

# Database Configuration (SQLite default; PostgreSQL connection string for production)
DATABASE_URL=sqlite:///./intently.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/intently

# Redis Configuration (Celery task queue & cache)
REDIS_URL=redis://localhost:6379/0

# Google Gemini API Key (Optional in offline/mock mode; provides live generative synthesis)
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-3.5-flash
GEMINI_PRO_MODEL=gemini-3.5-flash

# Security & Public Access Mode (Enables unrestricted UI exploration in portfolio/demo mode)
PUBLIC_ACCESS_MODE=True
API_SECRET_KEY=pulse-secret-dev-key-change-in-prod
CORS_ORIGINS=["*","http://localhost:3000","http://127.0.0.1:3000"]

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
