# ==========================================
# Pulse Discovery Engine - Production Backend
# ==========================================

ENVIRONMENT=production
LOG_LEVEL=INFO

# PostgreSQL Database (Railway / Cloud Managed)
DATABASE_URL=postgresql://pulse_user:pulse_secure_password_123@postgres.railway.internal:5432/railway

# Redis (Railway / Cloud Managed)
REDIS_URL=redis://default:pulse_redis_password@redis.railway.internal:6379/0
CELERY_BROKER_URL=redis://default:pulse_redis_password@redis.railway.internal:6379/0
CELERY_RESULT_BACKEND=redis://default:pulse_redis_password@redis.railway.internal:6379/0

# Google Gemini API
GEMINI_API_KEY=your_production_gemini_api_key_here

# Security & CORS
API_SECRET_KEY=generate_a_secure_64_character_hex_key_here
CORS_ORIGINS=["https://pulse-discovery.vercel.app","https://*.vercel.app"]

# Application Port
PORT=8000
