# Database Configuration
# Railway PostgreSQL URL or local Postgres/SQLite connection string
DATABASE_URL=sqlite:///./intently.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/intently

# Redis Configuration (Celery broker & cache)
REDIS_URL=redis://localhost:6379/0

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Security & API Auth
API_SECRET_KEY=intently-secret-dev-key-change-in-prod
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
